  "cross_org_model": {
    "participants": [
      {
        "organization": "org-a",
        "entity_aid": "$org_a_keri_entity_aid",
        "role": "one authenticated AFP session principal"
      },
      {
        "organization": "org-b",
        "entity_aid": "$org_b_keri_entity_aid",
        "role": "the other authenticated AFP session principal"
      }
    ],
    "session": {
      "party_count": 2,
      "session_ref": "$live_signed_session_ref",
      "session_context": "$live_signed_X_context",
      "authentication": "Each envelope sender is the expected counterparty and verifies under its KEL-current key and declared witness threshold.",
      "confidentiality": "The bilateral channel is end-to-end encrypted and metadata-private under AFP session-core policy."
    },
    "private_data": {
      "wire_presence": "absent",
      "storage": "party-controlled or authorized evidence stores",
      "forbidden_in_bundle_or_fixture": [
        "private record sets",
        "reciprocal input or output chunks",
        "proof witnesses",
        "proving keys",
        "decryption material",
        "delivery secrets"
      ],
      "allowed_public_surrogates": [
        "canonical Coord final proof bytes",
        "canonical CoordReceipt commitments",
        "canonical artifact identity",
        "profile-policy commitments"
      ]
    },
    "evidence_references": {
      "transport": "verifier-local or separately authorized retrieval; never embedded private evidence",
      "members": [
        "aggregateCommitment",
        "opaqueReference",
        "kind"
      ],
      "reference_digest": "sha256: followed by SHA-256 of canonical JSON over aggregateCommitment, opaqueReference, and kind",
      "verification": "Before invoking either configured verifier method, require exactly one reference for each nonzero receipt data-availability or external-fact commitment and no other reference. The verifier must retrieve and authenticate every admitted reference and return the exact sorted reference digests it verified; availability is a verifier outcome, never a caller-controlled member."
    },
    "completion_order": [
      "authenticate the bilateral session and sending party",
      "require message_class=result and the profile-defined sender direction",
      "recompute and compare the signed AFP session context",
      "derive the canonical Coord field context",
      "require the session-committed acceptance policy",
      "validate canonical RFC 3339 bundle metadata and reject an expired bundle",
      "consult the durable workflow-instance record; reject changed bytes, or recover an exact prior effect without depending on current verifier availability",
      "invoke the deployment-bound verifier over the complete canonical ZKA bundle",
      "invoke that same verifier over the Coord final proof and authorized evidence",
      "compare every receipt, profile, assurance, artifact, output, state, and evidence binding",
      "atomically persist the workflow-instance replay identity and canonical envelope effect",
      "only then project that durable record into the in-memory profile inbox"
    ],
    "pure_coord_bundle_profile": {
      "exact_top_level_members": [
        "compliance",
        "coord_proof",
        "metadata"
      ],
      "exact_compliance_value": {
        "proofs": []
      },
      "forbidden_side_channels": [
        "transaction",
        "binding",
        "compliance proofs",
        "compliance aggregation",
        "unknown members",
        "explicit null placeholders"
      ]
    }
  },
  "cryptographic_verifier_boundary": {
    "deployment_requirement": "A conforming pilot binds one concrete verifier adapter when the AFP Instance is created. That adapter must verify the complete canonical zka:bundle:v1 and the Coord final proof against the pinned ZKA profile, manifest, verification-key, recursive-artifact, and evidence-store coordinates.",
    "authority_rule": "The verifier and durable completion store are deployment-owned capabilities; an envelope sender or receive call cannot replace either one.",
    "terminal_outcome_rule": "The configured verifier may preserve only an exact allowlisted terminal COORD_V2 code through the typed CoordVerifierRejected signal. Unsupported, mutated, textual, or consumer-owned codes collapse to COORD_V2_VERIFIER_FAILURE; backend text is never returned.",
    "reference_test_scope": "The standard-library AFP tests use a deterministic conformance double only to exercise the consumer boundary, failure mapping, authority binding, and atomic storage. That double is not cryptographic proof evidence and cannot by itself satisfy a cross-organization pilot.",
    "positive_case_assertion": "independent_final_proof_verification=true is evidence a real pilot must obtain from its configured ZKA adapter before reporting the positive case as complete.",
    "retransmission_rule": "After session authentication, structural/freshness checks, and policy binding, a byte-identical durable record is already verified authority and may repair its inbox projection without recontacting a now-unavailable verifier; an unseen completion still requires both verifier calls."
  },
