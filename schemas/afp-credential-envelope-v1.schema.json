{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://afp.dev/schemas/afp-credential-envelope-v1.schema.json",
  "title": "AFP native credential-only session envelope v1",
  "description": "AFP framing only. Native ZKC/APR cryptography, schema, subject binding, timestamps, policy and replay checks are required independently; this schema never verifies a proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "session_ref",
    "session_context",
    "profile",
    "message_class",
    "generated_at",
    "expires_at",
    "presentation",
    "apr",
    "sender"
  ],
  "properties": {
    "kind": {
      "const": "afp:credential-envelope:v1"
    },
    "session_ref": {
      "type": "string",
      "minLength": 1
    },
    "session_context": {
      "type": "string",
      "pattern": "^X_[0-9a-f]{64}$"
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "message_class": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "presentation": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "enum": [
            "zkc:proof:v1",
            "zkc:proof:v2"
          ]
        }
      },
      "description": "Complete native ZKC-owned presentation; its selected version owns all remaining fields and verification."
    },
    "apr": {
      "type": "object",
      "minProperties": 1,
      "description": "Complete ZKC-owned signed Authenticated Proof Request; the ZKC adapter must enforce its exact schema and signature."
    },
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_aid",
        "entity_aid",
        "kel_event_dig",
        "signature"
      ],
      "properties": {
        "tenant_aid": {
          "type": "string",
          "minLength": 1
        },
        "entity_aid": {
          "type": "string",
          "minLength": 1
        },
        "kel_event_dig": {
          "type": "string",
          "minLength": 1
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      }
    }
  }
}
